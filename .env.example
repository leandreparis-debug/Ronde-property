# Copier ce fichier en `.env.local` (ignoré par git). Ne jamais y mettre de donnée réelle.

# Nom affiché de l'application (optionnel, défaut : RONDE).
NEXT_PUBLIC_APP_NAME=RONDE

# Supabase — optionnel à l'étape 1, requis à partir de l'étape 2.
# URL HTTPS du projet, par exemple https://xxxxxxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_URL=
# Clé anonyme (publique) du projet.
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé service role : côté serveur uniquement, jamais exposée au navigateur.
# SUPABASE_SERVICE_ROLE_KEY=

# Base de TEST locale (jamais un vrai projet Supabase). Valeur par défaut si absente.
# `pnpm db:reset` et `pnpm test:db` refusent tout hôte autre que localhost et toute base
# autre que ronde_test.
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/ronde_test

# Taille du pool de connexions par instance (5 par défaut ; pooler Supabase en mode transaction).
# DATABASE_POOL_MAX=5

# Fournisseur d'authentification : `supabase` (défaut, production) ou `local` (tests et
# développement uniquement). `local` exige ALLOW_LOCAL_AUTH=true, LOCAL_AUTH_SECRET
# (32 caractères minimum) et une DATABASE_URL sur localhost ; il est refusé sur Vercel.
# AUTH_PROVIDER=local
# ALLOW_LOCAL_AUTH=true
# LOCAL_AUTH_SECRET=changez-moi-32-caracteres-minimum-0123456789
